+ let maxW=0,maxH=0;
+ for(const el of nodes){
+   const w=parseFloat(el.style.width), parts=(el.style.aspectRatio||'1/1').split('/').map(Number);
+   const aspect=parts[0]/(parts[1]||1);
+   maxW=Math.max(maxW,w);maxH=Math.max(maxH,w/aspect);
+ }
+ const fit=Math.min(1,92/maxW,92*ratio/maxH);
+ if(Number.isFinite(fit)&&fit>0) nodes.forEach(el=>el.style.width=(parseFloat(el.style.width)*fit)+'%');
